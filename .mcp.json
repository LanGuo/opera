{
  "mcpServers": {
    "hypothesis-ledger": {
      "command": "uv",
      "args": ["run", "python", "-m", "hypothesis_ledger.server"],
      "env": {
        "ALLOW_HUMAN_INPUT": "false"
      }
    },
    "tooluniverse": {
      "command": "uvx",
      "args": ["tooluniverse"],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "NCBI_API_KEY": "${NCBI_API_KEY}",
        "BIOGRID_API_KEY": "${BIOGRID_API_KEY}",
        "DISGENET_API_KEY": "${DISGENET_API_KEY}",
        "NVIDIA_API_KEY": "${NVIDIA_API_KEY}"
      }
    }
  }
}
